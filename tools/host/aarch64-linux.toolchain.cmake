# aarch64 Linux cross build of the melonDS core (ACWW host port, docs/portability.md 4.4)
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(T $ENV{HOME}/acww/toolchains/arm-gnu-toolchain-14.3.rel1-x86_64-aarch64-none-linux-gnu)
set(CMAKE_C_COMPILER ${T}/bin/aarch64-none-linux-gnu-gcc)
set(CMAKE_CXX_COMPILER ${T}/bin/aarch64-none-linux-gnu-g++)
set(CMAKE_SYSROOT ${T}/aarch64-none-linux-gnu/libc)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
