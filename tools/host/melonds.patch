+void GPU3D::HostDrain() noexcept
+{
+    while (GeometryEnabled && !FlushRequest && !CmdPIPE.IsEmpty())
+    {
+        if (NumPushPopCommands == 0) GXStat &= ~(1<<14);
+        if (NumTestCommands == 0)    GXStat &= ~(1<<0);
+        ExecuteCommand();
+    }
+    CycleCount = 0;
+    if (CmdPIPE.IsEmpty() && (GXStat & (1<<27))) FinishWork(0);
+    if (NumPushPopCommands == 0) GXStat &= ~(1<<14);
+    if (NumTestCommands == 0)    GXStat &= ~(1<<0);
+}
