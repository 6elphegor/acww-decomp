+// acww harness: ring buffer of the last ARM9 instruction addresses (interpreter only)
+u32 gPcRing[1024]; u32 gPcRingPos = 0; bool gPcRingDumped = false;
+void DumpPcRing(const char* why)
+{
+    if (gPcRingDumped) return;
+    gPcRingDumped = true;
+    fprintf(stderr, "=== ARM9 PC trace before %s (oldest first) ===\n", why);
+    for (u32 i = 0; i < 1024; i++) {
+        u32 pc = gPcRing[(gPcRingPos + i) & 1023];
+        fprintf(stderr, "%08x%s", pc, (i % 8 == 7) ? "\n" : " ");
+    }
+}
