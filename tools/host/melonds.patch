+// acww harness: report ARM9 stores to [gWatchLo, gWatchHi)
+u32 gWatchLo = 0, gWatchHi = 0; int gWatchCount = 0;
+static inline void WatchCheck(ARMv5* cpu, u32 addr, u32 size, u32 val)
+{
+    if (gWatchHi && addr < gWatchHi && addr + size > gWatchLo && gWatchCount < 64)
+    {
+        gWatchCount++;
+        fprintf(stderr, "WATCH write%u [%08x] = %08x at pc %08x lr %08x\n", size * 8, addr, val,
+                cpu->R[15] - ((cpu->CPSR & 0x20) ? 4 : 8), cpu->R[14]);
+        fprintf(stderr, "  r0-r7 %08x %08x %08x %08x %08x %08x %08x %08x sp %08x\n", cpu->R[0], cpu->R[1], cpu->R[2],
+                cpu->R[3], cpu->R[4], cpu->R[5], cpu->R[6], cpu->R[7], cpu->R[13]);
+    }
+}
