# x86-64 Windows cross build of the melonDS core with llvm-mingw (clang, UCRT, libc++, lld): ACWW host port,
# docs/portability.md 4.4. cmake -DCMAKE_TOOLCHAIN_FILE=<this> -DLLVM_MINGW=<llvm-mingw directory> (default: the
# newest ~/acww/toolchains/llvm-mingw-*)
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
if(NOT LLVM_MINGW)
  file(GLOB _found $ENV{HOME}/acww/toolchains/llvm-mingw-*)
  list(SORT _found)
  list(GET _found -1 LLVM_MINGW)
endif()
set(CMAKE_C_COMPILER ${LLVM_MINGW}/bin/x86_64-w64-mingw32-clang)
set(CMAKE_CXX_COMPILER ${LLVM_MINGW}/bin/x86_64-w64-mingw32-clang++)
set(CMAKE_RC_COMPILER ${LLVM_MINGW}/bin/x86_64-w64-mingw32-windres)
set(CMAKE_AR ${LLVM_MINGW}/bin/llvm-ar)
set(CMAKE_RANLIB ${LLVM_MINGW}/bin/llvm-ranlib)
set(CMAKE_FIND_ROOT_PATH ${LLVM_MINGW}/x86_64-w64-mingw32)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
